providers:
  qwen-rtx5090:
    type: "openai"
    base_url: "http://100.124.93.99:11434/v1"
    api_key: "ollama"
    models:
      # qwen2.5-coder:7b-instruct deliberately not listed here -- Ollama
      # reports only 32,768 context for it, below Hermes Agent's hard
      # 64K-minimum floor (confirmed live), so it can never actually be
      # selected as a Hermes model regardless of being declared.
      - name: "qwen3-agent:latest"
      - name: "qwen3:30b"
      - name: "qwen3.8:27b"
  hermes4-jetson:
    type: "openai"
    base_url: "${HERMES4_BASE_URL}"
    api_key: "ollama"
    models:
      - name: "${HERMES4_MODEL_NAME}"

model:
  provider: qwen-rtx5090
  default: "qwen3-agent:latest"

mcp_servers:
  zorc:
    url: "https://mcp.zaindroid.me/mcp"
    headers:
      Authorization: "Bearer ${MCP_TOKEN}"

memory:
  provider: honcho

dashboard:
  theme: grok

tools:
  tool_search:
    # The local qwen3-agent model doesn't reliably follow the deferred
    # tool_call(name=..., arguments=...) wrapper indirection -- it drops
    # the required "name" field and loops. Disabling deferral exposes the
    # honcho memory tool (and everything else) directly instead.
    enabled: "off"
